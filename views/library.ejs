<%- include('partials/header') %>

    <div class="container mt-5">
        <h1 class="mb-4">My Library</h1>
        <% if (books.length > 0) { %>
            <div class="row">
                <% books.forEach(book => { %>
                    <div class="col-sm-6 col-md-3 mb-4">
                        <div class="card h-100">
                            <img src="https://covers.openlibrary.org/b/id/<%= book.cover_i %>-L.jpg" class="card-img-top" alt="<%= book.title %> cover">
                            <div class="card-body d-flex flex-column">
                                <h6 class="card-title"><%= book.title.substring(0, 30) %><% if (book.title.length > 30) { %>...<% } %></h6>
                                <p class="card-text small"><strong>Author:</strong> <%= book.authorname ? book.authorname.substring(0, 20) : 'Unknown' %><% if (book.authorname && book.authorname.length > 20) { %>...<% } %></p>
                                <% if (book.rating) { %>
                                    <p class="card-text small"><strong>Rating:</strong> <%= book.rating %>/5 - <%= ['', 'Poor', 'Fair', 'Good', 'Very Good', 'Masterpiece'][book.rating] %></p>
                                <% } %>
                                <% if (book.notes) { %>
                                    <p class="card-text small"><strong>Notes:</strong> <%= book.notes.substring(0, 50) %><% if (book.notes.length > 50) { %>...<% } %></p>
                                <% } %>
                                <button class="btn btn-primary btn-sm mt-auto" data-bs-toggle="modal" data-bs-target="#ratingModal" 
                                    data-title="<%= book.title %>" 
                                    data-cover="<%= book.cover_i %>" 
                                    data-author="<%= book.authorname ? book.authorname : 'Unknown' %>"
                                    data-rating="<%= book.rating || '' %>"
                                    data-notes="<%= book.notes || '' %>">
                                    Edit rate/notes
                                </button>
                                <button class="btn btn-danger btn-sm ms-2" data-cover="<%= book.cover_i %>">
                                    Delete
                                </button>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <p>No books in your library.</p>
        <% } %>
    </div>

    <div class="modal fade" id="ratingModal" tabindex="-1" aria-labelledby="ratingModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="ratingModalLabel">Edit Rate/Notes</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="ratingForm">
                        <input type="hidden" id="bookTitle" name="title">
                        <input type="hidden" id="bookCover" name="cover_i">
                        <input type="hidden" id="bookAuthor" name="author_name">
                        <input type="hidden" id="selectedRating" name="rating">
                        
                        <div class="mb-3">
                            <label class="form-label">Rating</label>
                            <div id="ratingButtons" class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-warning rating-btn" data-rating="1">1</button>
                                <button type="button" class="btn btn-outline-warning rating-btn" data-rating="2">2</button>
                                <button type="button" class="btn btn-outline-warning rating-btn" data-rating="3">3</button>
                                <button type="button" class="btn btn-outline-warning rating-btn" data-rating="4">4</button>
                                <button type="button" class="btn btn-outline-warning rating-btn" data-rating="5">5</button>
                            </div>
                            <p id="ratingText" class="mt-2 text-muted">Select a rating</p>
                        </div>
                        
                        <div class="mb-3">
                            <label for="notesTextarea" class="form-label">Notes</label>
                            <textarea class="form-control" id="notesTextarea" name="notes" rows="3" placeholder="Add your notes about this book..."></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="submitRatingBtn">Submit</button>
                </div>
            </div>
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script> 
        const ratingTexts = {
            1: "Poor",
            2: "Fair",
            3: "Good",
            4: "Very Good",
            5: "Masterpiece"
        };

        let selectedRating = 0;

        $(document).on('click', '.rating-btn', function() {
            selectedRating = parseInt($(this).data('rating'));
            $('#selectedRating').val(selectedRating);
            
            $('.rating-btn').removeClass('btn-warning').addClass('btn-outline-warning');
            $(this).removeClass('btn-outline-warning').addClass('btn-warning');
            
            $('#ratingText').text(ratingTexts[selectedRating]);
        });

        $('#ratingModal').on('show.bs.modal', function(event) {
            const button = event.relatedTarget;
            const existingRating = $(button).data('rating');
            
            $('#bookTitle').val($(button).data('title'));
            $('#bookCover').val($(button).data('cover'));
            $('#bookAuthor').val($(button).data('author'));
            $('#notesTextarea').val($(button).data('notes'));

            selectedRating = 0;
            $('#selectedRating').val('');
            $('#ratingText').text('Select a rating');
            $('.rating-btn').removeClass('btn-warning').addClass('btn-outline-warning');
            if (existingRating) {
                selectedRating = parseInt(existingRating);
                $('#selectedRating').val(selectedRating);
                $('#ratingText').text(ratingTexts[selectedRating]);
                $('.rating-btn').each(function() {
                    if (parseInt($(this).data('rating')) === selectedRating) {
                        $(this).removeClass('btn-outline-warning').addClass('btn-warning');
                    }
                });
            }
        });
        
        $('#submitRatingBtn').click(function() {
            if (selectedRating === 0) {
                alert('Please select a rating');
                return;
            }

            const formData = {
                title: $('#bookTitle').val(),
                cover_i: $('#bookCover').val(),
                author_name: $('#bookAuthor').val(),
                rating: selectedRating,
                notes: $('#notesTextarea').val()
            };

            $.ajax({
                type: 'PUT',
                url: '/edit-book',
                data: JSON.stringify(formData),
                contentType: 'application/json',
                success: function(data) {
                    alert('Book updated successfully!');
                    $('#ratingModal').modal('hide');
                },
                error: function(error) {
                    console.error('Error:', error);
                    alert('Error editing book');
                }
            });
        });

        // Handle delete button click
        $(document).on('click', '.btn-danger', function() {
            const cover_i = $(this).data('cover');
            if (confirm('Are you sure you want to delete this book?')) {
                $.ajax({
                    type: 'DELETE',
                    url: '/delete-book',
                    data: JSON.stringify({ cover_i: cover_i }),
                    contentType: 'application/json',
                    success: function(data) {
                        alert('Book deleted successfully!');
                        location.reload();
                    },
                    error: function(error) {
                        console.error('Error:', error);
                        alert('Error deleting book');
                    }
                });
            }
        });
    </script>

<%- include('partials/footer') %>